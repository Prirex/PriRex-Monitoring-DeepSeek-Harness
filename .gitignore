# installing the plugin never requires a build step.
lib-verify/
*.log

# --- Runtime caches ---------------------------------------------------------
.cache/
coverage/
.tmp/
temp/

# --- Local environment / secrets -------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.npmrc
!.npmrc.example

# --- Editors / IDEs ---------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# --- OS junk ----------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --- Release / packaging ----------------------------------------------------
*.tgz
*.zip
dist-release/
